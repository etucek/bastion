{% include 'partials/hero.html.twig' %}

{% set align_right = page.header.image_align|default('right') == 'right' %}
{% set image = page.header.image ? page.media[page.header.image] : page.media.images|first %}

<section class="{{ page.header.section_classes|default('py-16 md:py-24') }}">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <div class="flex flex-wrap items-center gap-8 md:flex-nowrap {{ align_right ? 'md:flex-row-reverse' : '' }}">
            {% if image %}
            <div class="w-full md:w-1/2">
                <img class="w-full rounded-lg" src="{{ image.url }}" alt="{{ page.title }}">
            </div>
            {% endif %}
            <div class="w-full {{ image ? 'md:w-1/2' : '' }}">
                {% if page.title %}<h2 class="mb-4 text-2xl font-bold sm:text-3xl">{{ page.title }}</h2>{% endif %}
                {% if page.content %}
                <div class="prose max-w-none text-neutral-600 dark:text-neutral-300">
                    {{ page.content|raw }}
                </div>
                {% endif %}
            </div>
        </div>
    </div>
</section>
