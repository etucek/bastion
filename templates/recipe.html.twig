{% extends 'partials/base.html.twig' %}
{% set recipe_meta = page.header.recipe|default({}) %}
{% set show_breadcrumbs = header_var('show_breadcrumbs', [page])|defined(true) %}
{% set show_pagination = header_var('show_pagination', [page])|defined(true) %}
{% set hero_image = page.header.hero.image ? page.media[page.header.hero.image] : page.media.images|first %}

{% block hero %}
    {% if hero_image %}
    <section class="relative h-64 overflow-hidden hero-section sm:h-80 md:h-96" style="background-image:url('{{ hero_image.url }}');background-size:cover;background-position:center;">
        <div class="absolute inset-0 bg-black/40"></div>
        <div class="relative flex h-full items-end">
            <div class="mx-auto w-full max-w-3xl px-4 pb-8 text-white sm:px-6 lg:px-8">
                <h1 class="text-3xl font-bold sm:text-4xl">{{ page.title }}</h1>
            </div>
        </div>
    </section>
    {% endif %}
{% endblock %}

{% block body %}
<section class="py-10">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
        {% if show_breadcrumbs and config.plugins.breadcrumbs.enabled %}
            <div class="mb-4">
                {% include 'partials/breadcrumbs.html.twig' %}
            </div>
        {% endif %}

        {% if not hero_image %}
        <h1 class="mb-2 text-3xl font-bold sm:text-4xl">{{ page.title }}</h1>
        {% endif %}

        {% if recipe_meta.prep_time or recipe_meta.cook_time or recipe_meta.servings or recipe_meta.difficulty %}
        <div class="my-4 flex flex-wrap gap-6 text-sm text-gray-600 dark:text-gray-400">
            {% if recipe_meta.prep_time %}<span><i class="fa-solid fa-clock" aria-hidden="true"></i> <strong>{{ 'THEME_BASTION.BLUEPRINTS.RECIPE_PREP_TIME'|t }}:</strong> {{ recipe_meta.prep_time }}</span>{% endif %}
            {% if recipe_meta.cook_time %}<span><i class="fa-solid fa-fire" aria-hidden="true"></i> <strong>{{ 'THEME_BASTION.BLUEPRINTS.RECIPE_COOK_TIME'|t }}:</strong> {{ recipe_meta.cook_time }}</span>{% endif %}
            {% if recipe_meta.servings %}<span><i class="fa-solid fa-utensils" aria-hidden="true"></i> <strong>{{ 'THEME_BASTION.BLUEPRINTS.RECIPE_SERVINGS'|t }}:</strong> {{ recipe_meta.servings }}</span>{% endif %}
            {% if recipe_meta.difficulty %}<span><i class="fa-solid fa-gauge" aria-hidden="true"></i> <strong>{{ 'THEME_BASTION.BLUEPRINTS.RECIPE_DIFFICULTY'|t }}:</strong> {{ ('THEME_BASTION.BLUEPRINTS.RECIPE_DIFFICULTY_' ~ recipe_meta.difficulty|upper)|t }}</span>{% endif %}
        </div>
        {% endif %}

        <div class="prose max-w-none text-gray-700 dark:text-gray-300">
            {{ page.content|raw }}
        </div>

        {% if recipe_meta.ingredients|length or recipe_meta.instructions|length %}
        <div class="my-8 grid grid-cols-1 gap-8 md:grid-cols-3">
            {% if recipe_meta.ingredients|length %}
            <div class="md:col-span-1">
                <h2 class="mb-3 text-xl font-bold">{{ 'THEME_BASTION.BLUEPRINTS.RECIPE_INGREDIENTS'|t }}</h2>
                <ul class="list-inside list-disc space-y-1 text-gray-700 dark:text-gray-300">
                    {% for ingredient in recipe_meta.ingredients %}
                    <li>{{ [ingredient.amount, ingredient.unit, ingredient.name]|filter(v => v)|join(' ') }}</li>
                    {% endfor %}
                </ul>
            </div>
            {% endif %}

            {% if recipe_meta.instructions|length %}
            <div class="md:col-span-2">
                <h2 class="mb-3 text-xl font-bold">{{ 'THEME_BASTION.BLUEPRINTS.RECIPE_INSTRUCTIONS'|t }}</h2>
                <ol class="list-inside list-decimal space-y-3 text-gray-700 dark:text-gray-300">
                    {% for instruction in recipe_meta.instructions %}
                    <li>{{ instruction.step }}</li>
                    {% endfor %}
                </ol>
            </div>
            {% endif %}
        </div>
        {% endif %}

        {{ bastion_gallery_section() }}

        {% if page.header.comments and config.plugins['comments-pro'].enabled %}
            {% include 'partials/comments-section.html.twig' ignore missing %}
        {% endif %}

        {% if show_pagination %}
        {# page.prevSibling/nextSibling are never actually falsy at the first/
           last item - Collection::adjacentSibling() (Grav core) returns the
           collection itself there instead of false, so `{% if page.prevSibling %}`
           alone is always true. .url is genuinely empty in that case (a real
           sibling page's url never is), so check that instead. #}
        <nav class="mt-10 flex justify-center gap-3 border-t border-gray-200 pt-6 text-center dark:border-gray-800" aria-label="{{ 'THEME_BASTION.ARIA.POST_NAVIGATION'|t|e('html_attr') }}">
            {% if page.prevSibling.url %}
                <a class="inline-block rounded-md border border-gray-300 px-4 py-2 text-sm hover:bg-gray-50 dark:border-gray-700 dark:hover:bg-gray-800" href="{{ page.prevSibling.url }}"><i class="fa-solid fa-angle-left" aria-hidden="true"></i> {{ 'THEME_BASTION.BLOG.ITEM.PREV_POST'|t }}</a>
            {% endif %}
            {% if page.nextSibling.url %}
                <a class="inline-block rounded-md border border-gray-300 px-4 py-2 text-sm hover:bg-gray-50 dark:border-gray-700 dark:hover:bg-gray-800" href="{{ page.nextSibling.url }}">{{ 'THEME_BASTION.BLOG.ITEM.NEXT_POST'|t }} <i class="fa-solid fa-angle-right" aria-hidden="true"></i></a>
            {% endif %}
        </nav>
        {% endif %}
    </div>
</section>
{% endblock %}
