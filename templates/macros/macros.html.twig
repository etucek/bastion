{% macro nav_loop(page, depth) %}
  {% import _self as macros %}
  {% set depth = depth|default(0) %}
  {% for p in page.children.visible %}
    {% set active_page = (p.active or p.activeChild) ? 'text-neutral-900 dark:text-white' : 'text-neutral-600 dark:text-neutral-300' %}
    {% set has_children = p.children.visible.count > 0 %}
    <li{% if has_children %} class="has-children relative"{% endif %}>
      <a href="{{ p.url }}" class="flex items-center gap-1.5 rounded-md px-3 py-2 text-sm font-medium hover:text-neutral-900 dark:hover:text-white {{ active_page }}">
        {% if p.header.menu_icon %}<i class="{{ p.header.menu_icon|fa_icon }}" aria-hidden="true"></i>{% endif %}
        {{ p.menu }}
        {% if has_children %}<i class="fa-solid fa-chevron-down text-xs opacity-60" aria-hidden="true"></i>{% endif %}
      </a>
      {% if has_children %}
      <ul class="dropmenu-panel">
        {{ macros.nav_loop(p, depth + 1) }}
      </ul>
      {% endif %}
    </li>
  {% endfor %}
{% endmacro %}
