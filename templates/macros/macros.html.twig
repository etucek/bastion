{% macro nav_loop(page, depth) %}
  {% import _self as macros %}
  {% set depth = depth|default(0) %}
  {% set default_classes = {
    a: 'flex w-full items-center gap-1.5 rounded-lg px-3 py-3 text-xl font-medium hover:bg-gray-100 hover:text-primary dark:hover:bg-gray-700/60',
    li: 'text-gray-700 dark:text-gray-300'
  } %}
  {% set nested_classes = {
    a: 'flex w-full items-center gap-1.5 px-2 py-2 text-base hover:text-primary',
    li: 'text-gray-700 dark:text-gray-300'
  } %}
  {% set classes = depth == 0 ? default_classes : nested_classes %}

  {# Individual content items (blog posts, recipes) shouldn't clutter the
     primary nav just because their folder happens to have a numeric prefix -
     .visible alone doesn't know that, it only looks at that prefix. #}
  {% for p in page.children.visible if p.template not in ['post', 'recipe'] %}
    {% set active_page = (p.active or p.activeChild) ? 'text-gray-900 dark:text-white' : classes.li %}
    {% set has_children = p.children.visible|filter(c => c.template not in ['post', 'recipe'])|length > 0 %}
    <li data-menu-item data-expanded="{{ p.activeChild ? 'true' : 'false' }}" class="{{ active_page }}">
      <div class="flex w-full items-center">
        <a class="{{ classes.a }}" href="{{ p.url }}">
          {% if p.header.menu_icon %}<i class="{{ p.header.menu_icon|fa_icon }}" aria-hidden="true"></i>{% endif %}
          {{ p.menu }}
        </a>
        {% if has_children %}
        <button type="button" data-menu-toggle class="flex h-10 w-10 shrink-0 items-center justify-center text-gray-500" aria-label="{{ 'THEME_BASTION.ARIA.EXPAND_MENU'|t|e('html_attr') }}">
          <div data-menu-icon-open class="{{ p.activeChild ? '' : 'hidden' }}"><i class="fa-solid fa-minus" aria-hidden="true"></i></div>
          <div data-menu-icon-closed class="{{ p.activeChild ? 'hidden' : '' }}"><i class="fa-solid fa-plus" aria-hidden="true"></i></div>
        </button>
        {% endif %}
      </div>
      {% if has_children %}
      <ul data-menu-panel class="space-y-1 py-1 pl-4 {{ p.activeChild ? '' : 'hidden' }}">
        {{ macros.nav_loop(p, depth + 1) }}
      </ul>
      {% endif %}
    </li>
  {% endfor %}
{% endmacro %}
