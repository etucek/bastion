{% extends 'partials/base.html.twig' %}

{% block body %}
<section class="py-10">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <h1 class="mb-8 text-3xl font-bold sm:text-4xl">{{ page.title }}</h1>

        {% if page.content %}
        <div class="prose mb-8 max-w-none text-gray-600 dark:text-gray-300">
            {{ page.content|raw }}
        </div>
        {% endif %}

        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {% for child in page.collection() %}
            <a href="{{ child.url }}" class="block rounded-lg border border-gray-200 p-5 hover:border-gray-300 dark:border-gray-800 dark:hover:border-gray-700">
                <h2 class="text-lg font-semibold">{{ child.title }}</h2>
                {% if child.header.recipe.difficulty %}
                <span class="mt-2 inline-block rounded-full bg-gray-100 px-2.5 py-0.5 text-xs font-medium text-gray-600 dark:bg-gray-800 dark:text-gray-300">
                    {{ child.header.recipe.difficulty }}
                </span>
                {% endif %}
            </a>
            {% endfor %}
        </div>
    </div>
</section>
{% endblock %}
