{% extends 'partials/base.html.twig' %}
{% set blog_image = page.header.hero.image ? page.media[page.header.hero.image] : page.media.images|first %}
{% set collection = page.collection() %}
{% set show_breadcrumbs = header_var('show_breadcrumbs', [page])|defined(true) %}
{% set show_pagination = header_var('show_pagination', [page])|defined(true) %}
{% set grid_classes = page.header.content.grid_classes|default('grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6') %}

{% block hero %}
    {% if blog_image %}
        {% include 'partials/hero.html.twig' with {id: 'blog-hero', content: page.content, hero_image: blog_image, force_display: true} %}
    {% endif %}
{% endblock %}

{# No sidebar and no secondary navigation on this template, matching
   bastion-old's blog.html.twig - a plain full-bleed card grid. #}
{% block body %}
    <section id="body-wrapper" class="bg-gray-100 py-12 dark:bg-gray-800">
        <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
            {% if show_breadcrumbs and config.plugins.breadcrumbs.enabled %}
                <div class="mb-4">
                    {% include 'partials/breadcrumbs.html.twig' %}
                </div>
            {% endif %}

            {% if not blog_image and page.title %}
                <header class="blog-page-header mb-8">
                    <h1 class="text-3xl font-bold sm:text-4xl">{{ page.title }}</h1>
                    {% if page.header.subtitle %}
                        <p class="lead mt-2 text-lg text-gray-500 dark:text-gray-400">{{ page.header.subtitle }}</p>
                    {% endif %}
                    {% if page.content|striptags|trim is not empty %}
                        <div class="blog-page-intro prose mt-4 max-w-none text-gray-600 dark:text-gray-300">{{ page.content|raw }}</div>
                    {% endif %}
                </header>
            {% endif %}

            <div class="grid {{ grid_classes }}">
            {% for child in collection %}
                {% include 'partials/blog-list-item.html.twig' with {blog: page, page: child} %}
            {% endfor %}
            </div>

            {% if show_pagination and config.plugins.pagination.enabled and collection.params.pagination %}
                <div id="listing-footer" class="mt-8 flex justify-center">
                    {% include 'partials/pagination.html.twig' with {base_url: page.url, pagination: collection.params.pagination} %}
                </div>
            {% endif %}
        </div>
    </section>
{% endblock %}
