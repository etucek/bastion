{% extends 'partials/base.html.twig' %}

{% block content %}
    <div class="mx-auto flex max-w-2xl flex-col items-center px-4 py-16 text-center sm:px-6 sm:py-24 lg:px-8">
        <i class="fa-solid fa-compass mb-4 text-5xl text-primary" aria-hidden="true"></i>

        <p class="text-7xl font-extrabold tracking-tight text-gray-200 sm:text-8xl dark:text-gray-700">
            {{ page.header.http_response_code }}
        </p>

        <h1 class="mt-2 text-2xl font-bold text-gray-900 sm:text-3xl dark:text-white">
            {{ 'PLUGIN_ERROR.ERROR'|t }}
        </h1>

        <div class="mt-3 max-w-sm text-gray-600 dark:text-gray-400">
            {{ page.content|raw }}
        </div>

        <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
            <a href="{{ home_url }}" class="inline-flex items-center gap-2 rounded-full bg-primary px-5 py-2.5 text-sm font-semibold text-white transition hover:brightness-95">
                <i class="fa-solid fa-house" aria-hidden="true"></i>
                {{ 'THEME_BASTION.ERROR.BACK_HOME'|t }}
            </a>
            {% if config.plugins.simplesearch.enabled %}
            <button type="button" data-search-toggle="open" class="inline-flex items-center gap-2 rounded-full border border-gray-300 px-5 py-2.5 text-sm font-semibold text-gray-700 transition hover:border-primary hover:text-primary dark:border-gray-600 dark:text-gray-200">
                <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                {{ 'THEME_BASTION.SEARCH.HEADLINE'|t }}
            </button>
            {% endif %}
        </div>
    </div>
{% endblock %}
