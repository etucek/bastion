{% set image = page.media.images|first %}
<article class="flex h-full flex-col overflow-hidden rounded-md bg-white shadow-lg ring-1 ring-black/5 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl dark:bg-gray-700/40 dark:ring-white/10">
    {% if image %}
    <a href="{{ page.url }}">{{ image.cropZoom(800, 420).html|raw }}</a>
    {% endif %}
    <div class="flex-1 p-4">
        {% include 'partials/blog/taxonomy.html.twig' %}
        <a href="{{ page.url }}" class="transition">
            <h3 class="mt-4 mb-2 text-xl font-semibold text-gray-900 hover:text-black dark:text-gray-100 dark:hover:text-white">
                {{ page.title }}
            </h3>
        </a>
        <div class="prose text-base leading-normal text-gray-600 dark:text-gray-300">
            {% if page.summary != page.content %}
                {{ page.summary|raw }}
            {% else %}
                {{ page.content|raw }}
            {% endif %}
        </div>
    </div>
    <div class="px-4 pb-4 text-sm text-gray-500 dark:text-gray-400">
        {% include 'partials/blog/date.html.twig' %}
        {% if page.header.author %} - {{ page.header.author }}{% endif %}
    </div>
</article>
