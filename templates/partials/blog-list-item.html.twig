<article class="card h-entry overflow-hidden rounded-lg border border-gray-200 dark:border-gray-800">
    {% set image = page.media.images|first %}
    {% if image %}
    <a class="card-image block" href="{{ page.url }}">{{ image.cropZoom(800, 420).html|raw }}</a>
    {% endif %}
    <div class="p-5">
        <header class="card-header mb-3">
            <div class="card-subtitle mb-1">
                {% include 'partials/blog/date.html.twig' %}
            </div>
            <div class="card-title">
                {% include 'partials/blog/title.html.twig' with {title_level: 'h3'} %}
            </div>
        </header>
        <div class="card-body prose max-w-none text-sm text-gray-600 dark:text-gray-300">
            {% if page.summary != page.content %}
                {{ page.summary|raw }}
            {% else %}
                {{ page.content|raw }}
            {% endif %}
        </div>
        <footer class="card-footer mt-4">
            {% include 'partials/blog/taxonomy.html.twig' %}
        </footer>
    </div>
</article>
