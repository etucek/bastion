{% set show_sidebar = show_sidebar is defined ? show_sidebar : true %}
<div class="flex flex-col gap-10 {{ show_sidebar ? 'lg:flex-row' : '' }}">
    <div id="item" class="min-w-0 flex-1">
        {% block item %}{% endblock %}
    </div>
    {% if show_sidebar %}
    <aside id="sidebar" class="w-full lg:w-72 lg:shrink-0">
        {% block sidebar %}{% endblock %}
    </aside>
    {% endif %}
</div>
