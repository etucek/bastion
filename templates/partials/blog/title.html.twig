{% set title_level = title_level ?: 'h2' %}
{% set title_classes = title_level == 'h1' ? 'text-3xl font-bold sm:text-4xl' : 'text-lg font-semibold' %}
{% if page.header.link %}
    <{{ title_level }} class="p-name {{ title_classes }}">
        {% if page.header.continue_link is not same as(false) %}
        <a href="{{ page.url }}" aria-label="{{ 'THEME_BASTION.ARIA.OPEN_POST'|t|e('html_attr') }}" class="hover:underline"><i class="fa-solid fa-angles-right u-url" aria-hidden="true"></i></a>
        {% endif %}
        <a href="{{ page.header.link }}" class="u-url hover:underline">{{ page.title }}</a>
    </{{ title_level }}>
{% else %}
    <{{ title_level }} class="p-name {{ title_classes }}"><a href="{{ page.url }}" class="u-url hover:underline">{{ page.title }}</a></{{ title_level }}>
{% endif %}
