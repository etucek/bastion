{% set footer = theme_var('footer') %}
<footer id="footer" class="border-t border-gray-200 bg-gray-50 text-sm dark:border-gray-800 dark:bg-gray-800/40">
    <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6 lg:px-8">
        {% if footer.menu_enabled and footer.menu %}
        <nav class="mb-6 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-gray-600 md:justify-start dark:text-gray-400" aria-label="{{ 'THEME_BASTION.ARIA.FOOTER_NAV'|t|e('html_attr') }}">
            {% for item in footer.menu %}
                <a href="{{ item.link }}" {% if item.newtab %}target="_blank" rel="noopener"{% endif %}
                   class="hover:text-[var(--accent)]">{{ item.label }}</a>
            {% endfor %}
        </nav>
        {% endif %}

        {% if footer.social_enabled and footer.social %}
        <div class="mb-6 flex items-center justify-center gap-3 md:justify-start">
            {% for item in footer.social %}
                {% set brand = item.network|replace({'__brands': ''}) %}
                <a href="{{ item.link }}" aria-label="{{ brand }}" {% if item.newtab|default(true) %}target="_blank" rel="noopener"{% endif %}
                   class="flex h-9 w-9 items-center justify-center rounded-full bg-gray-200 text-gray-700 opacity-90 transition hover:opacity-100 hover:text-[var(--accent)] dark:bg-gray-700 dark:text-gray-200">
                    <i class="fa-brands fa-{{ brand }}" aria-hidden="true"></i>
                </a>
            {% endfor %}
        </div>
        {% endif %}

        <div class="flex flex-col items-center justify-between gap-4 text-gray-600 md:flex-row dark:text-gray-400">
            <div class="text-center md:text-left">
                {{ footer.copyright|markdown|raw }}
            </div>
            <div class="opacity-75 transition hover:opacity-100">
                {% include 'partials/logo.html.twig' %}
            </div>
        </div>
    </div>
</footer>
