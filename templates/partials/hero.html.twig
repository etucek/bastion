{#
  Renders a page/section hero banner from the page's own `hero:` frontmatter:
  display, alignment, padding, overlay (dark - the only value any content on
  this site actually uses), overlay_direction, overlay_gradient (two opacity
  stops), title.text, subtitle, image, content.

  bastion-old computes this overlay via a custom color_object Twig filter
  (theme PHP + the color-tools plugin) so any named color works as the
  overlay. Since every page here only ever sets overlay: dark, that generality
  isn't needed - dark's underlying color (#222222) is inlined directly.
#}
{% set hero = page.header.hero %}
{% if hero.display or force_display %}
{% set hero_image = hero.image ? page.media[hero.image] : null %}
{% set direction = hero.overlay_direction|default('bottom') %}
{% set gradient = hero.overlay_gradient|default([0.6, 0.2]) %}
{% set gradient_from = gradient|first %}
{% set gradient_to = gradient|last %}
{% set alignment = hero.alignment|default('left') %}
{% set align_items = alignment == 'center' ? 'items-center' : (alignment == 'right' ? 'items-end' : 'items-start') %}
{% set text_align = alignment == 'center' ? 'text-center' : (alignment == 'right' ? 'text-right' : 'text-left') %}
<section class="relative overflow-hidden {{ hero_image ? 'hero-section' }} {{ hero.padding|default('py-24 md:py-32') }}"
         {% if hero_image %}style="background-image:url('{{ hero_image.url }}');background-size:cover;background-position:center;"{% endif %}>
    {% if hero_image %}
    <div class="absolute inset-0" style="background-image: linear-gradient(to {{ direction }}, rgba(34,34,34,{{ gradient_from }}), rgba(34,34,34,{{ gradient_to }}));"></div>
    {% endif %}
    <div class="relative mx-auto flex max-w-6xl flex-col px-4 sm:px-6 lg:px-8 {{ align_items }}">
        <div class="w-5/6 md:w-3/4 lg:w-2/3 xl:w-1/2 {{ text_align }}">
            {% if hero.subtitle %}
            <p class="mb-2 text-sm font-semibold uppercase tracking-wide opacity-75 {{ hero_image ? 'text-gray-300' : 'text-gray-600 dark:text-gray-400' }}">
                {{ hero.subtitle }}
            </p>
            {% endif %}
            <h1 class="text-2xl font-extrabold tracking-tight sm:text-3xl md:text-4xl lg:text-5xl {{ hero_image ? 'text-white' : '' }}">
                {{ hero.title.text|default(page.title) }}
            </h1>
            {% if hero.content %}
            <div class="mt-3 text-lg md:text-xl {{ hero_image ? 'text-gray-200' : 'text-gray-700 dark:text-gray-300' }}">
                {{ hero.content|markdown }}
            </div>
            {% endif %}
        </div>
    </div>
</section>
{% endif %}
