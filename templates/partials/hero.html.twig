{#
  Renders a page/section hero banner from the page's own `hero:` frontmatter:
  display, alignment, padding, overlay (dark/light/none), overlay_direction,
  overlay_gradient (two opacity stops), title.text, subtitle, image, content.

  A caller may pass its own `hero_image` and/or `content` in via `with
  {...}` (blog.html.twig does, falling back to the blog listing's first
  post image when no hero.image is set) - honored here only if actually
  passed, so plain page-header-driven callers behave exactly as before.
  `id` is passed straight through as the section's DOM id, if given.

  bastion-old computes the overlay color via a custom color_object Twig
  filter (theme PHP + the color-tools plugin) so any named color works as
  the overlay. This theme's own blueprint only ever offers dark/light/none,
  so that generality isn't needed - each maps to a plain black or white
  rgba() overlay inlined directly, and the hero text color follows suit
  (white text reads on a dark overlay, dark text on a light one).
#}
{% set hero = page.header.hero %}
{% if hero.display or force_display %}
{% set hero_image = hero_image is defined ? hero_image : (hero.image ? page.media[hero.image] : null) %}
{# page.content arrives pre-rendered HTML; hero.content is raw markdown text
   from the page header and needs the |markdown filter below - keep track of
   which one this is so it isn't double-processed either way. #}
{% set hero_content_is_html = content is defined %}
{% set hero_content = hero_content_is_html ? content : hero.content %}
{% set overlay = hero.overlay|default('dark') %}
{% set overlay_rgb = overlay == 'light' ? '255,255,255' : '0,0,0' %}
{% set light_text = hero_image and overlay != 'light' %}
{% set direction = hero.overlay_direction|default('bottom') %}
{% set gradient = hero.overlay_gradient|default([0.6, 0.2]) %}
{% set gradient_from = gradient|first %}
{% set gradient_to = gradient|last %}
{% set alignment = hero.alignment|default('left') %}
{% set align_items = alignment == 'center' ? 'items-center' : (alignment == 'right' ? 'items-end' : 'items-start') %}
{% set text_align = alignment == 'center' ? 'text-center' : (alignment == 'right' ? 'text-right' : 'text-left') %}
<section {% if id is defined %}id="{{ id }}"{% endif %} class="relative overflow-hidden {{ hero_image ? 'hero-section' }} {{ hero.padding|default('py-24 md:py-32') }}"
         {% if hero_image %}style="background-image:url('{{ hero_image.url }}');background-size:cover;background-position:center;"{% endif %}>
    {% if hero_image and overlay != 'none' %}
    <div class="absolute inset-0" style="background-image: linear-gradient(to {{ direction }}, rgba({{ overlay_rgb }},{{ gradient_from }}), rgba({{ overlay_rgb }},{{ gradient_to }}));"></div>
    {% endif %}
    <div class="relative mx-auto flex max-w-6xl flex-col px-4 sm:px-6 lg:px-8 {{ align_items }}">
        <div class="w-5/6 md:w-3/4 lg:w-2/3 xl:w-1/2 {{ text_align }}">
            {% if hero.subtitle %}
            <p class="mb-2 text-sm font-semibold uppercase tracking-wide opacity-75 {{ light_text ? 'text-gray-300' : 'text-gray-600 dark:text-gray-400' }}">
                {{ hero.subtitle }}
            </p>
            {% endif %}
            <h1 class="text-2xl font-extrabold tracking-tight sm:text-3xl md:text-4xl lg:text-5xl {{ light_text ? 'text-white' : '' }}">
                {{ hero.title.text|default(page.title) }}
            </h1>
            {% if hero_content %}
            <div class="mt-3 text-lg md:text-xl {{ light_text ? 'text-gray-200' : 'text-gray-700 dark:text-gray-300' }}">
                {{ hero_content_is_html ? hero_content|raw : hero_content|markdown }}
            </div>
            {% endif %}
        </div>
    </div>
</section>
{% endif %}
