{% set body_classes = body_class(['header-fixed', 'header-animated', 'header-transparent', 'header-dark', 'header-light', 'sticky-footer']) %}
{% set theme_default = theme_var('theme-mode') ?: 'auto' %}
{% set accent = theme_var('accent-color') %}
{% set accent_is_hex = accent and accent matches '/^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$/' %}
{% set fa_enabled = theme_var('fontawesome.enabled') %}
{% set fa_local   = theme_var('fontawesome.local') %}
{% use 'blocks/base.html.twig' %}
<!DOCTYPE html>
<html lang="{{ grav.language.getActive ?: grav.config.site.default_lang }}"
      data-theme-default="{{ theme_default }}">
<head>
{% block head deferred %}
    <meta charset="utf-8" />
    <title>{% if page.title %}{{ page.title|e('html') }} | {% endif %}{{ site.title|e('html') }}</title>
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light dark">

    {% include 'partials/metadata.html.twig' %}

    <link rel="icon" type="image/png" href="{{ url('theme://images/favicon.png') }}" />
    <link rel="canonical" href="{{ page.url(true, true) }}" />

    {# Preload the critical latin subsets so headings + body text render in-font on first paint #}
    <link rel="preload" as="font" type="font/woff2" crossorigin href="{{ url('theme://fonts/cal-sans/cal-sans-latin.woff2') }}" />
    <link rel="preload" as="font" type="font/woff2" crossorigin href="{{ url('theme://fonts/inter/inter-latin.woff2') }}" />

    {% if accent_is_hex %}
    {# User-configured accent: tint links, focus ring, and filled UI accents with the chosen hex #}
    <style>
      :root {
        --accent: {{ accent }};
        --accent-contrast: #ffffff;
        --link: {{ accent }};
        --focus-ring: color-mix(in oklab, {{ accent }} 45%, transparent);
      }
      :root[data-theme='dark'] {
        --accent: color-mix(in oklab, {{ accent }} 80%, white 20%);
        --accent-contrast: #ffffff;
        --link: color-mix(in oklab, {{ accent }} 75%, white 25%);
        --focus-ring: color-mix(in oklab, {{ accent }} 45%, transparent);
      }
    </style>
    {% endif %}

    {# Pre-paint theme bootstrap — blocks FOUC by setting data-theme synchronously #}
    <script>
    (function () {
      try {
        var d = document.documentElement;
        var stored = localStorage.getItem('bastion-theme');
        var pref = stored || d.getAttribute('data-theme-default') || 'auto';
        var isDark = pref === 'dark' || (pref === 'auto' && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches);
        d.setAttribute('data-theme', isDark ? 'dark' : 'light');
        d.setAttribute('data-theme-preference', pref);
        d.classList.toggle('dark', isDark);
      } catch (e) {}
    })();
    </script>
{% endblock head %}

{% block stylesheets %}
    {% do assets.addCss('theme://css/fonts.css', 100) %}
    {% do assets.addCss('theme://build/css/site.css', 90) %}
    {% if fa_enabled %}
        {% if fa_local %}
            {% do assets.addCss('theme://css/fontawesome/all.min.css', 85) %}
        {% else %}
            {% do assets.addCss('https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css', 85) %}
        {% endif %}
    {% endif %}
    {% do assets.addCss('theme://css/custom.css', 80) %}
{% endblock %}

{% block javascripts %}
    {% do assets.addJs('theme://js/theme-toggle.js', {group:'head', priority: 100}) %}
    {% do assets.addJs('theme://js/site.js', {group:'bottom', priority: 100}) %}
{% endblock %}

{% block assets deferred %}
    {{ assets.css()|raw }}
    {{ assets.js()|raw }}
{% endblock %}
</head>
<body id="top" class="{% block body_classes %}{{ body_classes }}{% endblock %} min-h-screen flex flex-col bg-white text-neutral-900 dark:bg-neutral-950 dark:text-neutral-100">
    <div id="page-wrapper" class="flex flex-col flex-1">
    {% block header %}
        <header id="header" class="sticky top-0 z-40 border-b border-neutral-200 bg-white/90 backdrop-blur transition-shadow dark:border-neutral-800 dark:bg-neutral-950/90 [.scrolled_&]:shadow-sm">
            <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
                <nav class="flex h-16 items-center justify-between gap-4" aria-label="{{ 'THEME_BASTION.ARIA.PRIMARY_NAV'|t|e('html_attr') }}">
                    <button type="button" id="toggle" class="relative -ml-2 inline-flex items-center gap-2 rounded-full border border-neutral-300 py-1.5 pl-2 pr-3 hover:border-[var(--accent)] hover:text-[var(--accent)] dark:border-neutral-600" aria-label="{{ 'THEME_BASTION.ARIA.OPEN_MENU'|t|e('html_attr') }}">
                        <span class="relative flex h-5 w-5 items-center justify-center">
                            <span class="top absolute h-0.5 w-4 -translate-y-1.5 bg-current transition-transform [#toggle.active_&]:translate-y-0 [#toggle.active_&]:rotate-45"></span>
                            <span class="middle absolute h-0.5 w-4 bg-current transition-opacity [#toggle.active_&]:opacity-0"></span>
                            <span class="bottom absolute h-0.5 w-4 translate-y-1.5 bg-current transition-transform [#toggle.active_&]:translate-y-0 [#toggle.active_&]:-rotate-45"></span>
                        </span>
                        <span class="text-sm font-medium">{{ 'THEME_BASTION.ARIA.MENU'|t }}</span>
                    </button>
                    <div class="flex items-center gap-3">
                        {% if config.plugins.simplesearch.enabled %}
                        <button type="button" data-search-toggle="open" class="flex h-8 w-8 items-center justify-center rounded-md text-neutral-600 hover:text-[var(--accent)] dark:text-neutral-300" aria-label="{{ 'THEME_BASTION.SEARCH.OPEN'|t|e('html_attr') }}">
                            <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                        </button>
                        {% endif %}
                        {% include 'partials/theme-toggle.html.twig' %}
                        {% if config.plugins.login.enabled and grav.user.username %}
                            <span class="flex items-center gap-1.5 text-sm"><i class="fa-solid fa-user" aria-hidden="true"></i> {% include 'partials/login-status.html.twig' ignore missing %}</span>
                        {% endif %}
                    </div>
                </nav>
            </div>
        </header>
    {% endblock %}

    {% block hero %}{% endblock %}

        <main id="start" class="flex-1">
        {% block body %}
            <section id="body-wrapper" class="py-10">
                <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
                    {% block messages %}
                        {% include 'partials/messages.html.twig' ignore missing %}
                    {% endblock %}
                    {{ block('content_surround') }}
                </div>
            </section>
        {% endblock %}
        </main>

    </div>

    {% block footer %}
        {% include 'partials/footer.html.twig' %}
    {% endblock %}

    {% block mobile %}
    <div id="overlay" class="fixed inset-0 z-50 hidden items-start justify-center bg-neutral-900/50 px-4 pt-20 backdrop-blur-sm sm:pt-24 [&.open]:flex" role="dialog" aria-label="{{ 'THEME_BASTION.ARIA.MENU'|t|e('html_attr') }}">
        <div class="max-h-[75vh] w-full max-w-xl overflow-y-auto rounded-2xl bg-white p-4 shadow-2xl sm:p-6 dark:bg-neutral-900">
            <div class="mb-4 flex items-center justify-between">
                <span class="text-sm font-semibold uppercase tracking-wide text-neutral-500 dark:text-neutral-400">{{ 'THEME_BASTION.ARIA.MENU'|t }}</span>
                <button type="button" data-mobile-close class="-m-1 flex h-8 w-8 items-center justify-center rounded-md text-neutral-500 hover:text-[var(--accent)] dark:text-neutral-400" aria-label="{{ 'THEME_BASTION.ARIA.CLOSE_MENU'|t|e('html_attr') }}">
                    <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                </button>
            </div>
            {% if config.plugins.simplesearch.enabled %}
            <button type="button" data-search-toggle="open" data-mobile-close class="mb-3 flex items-center gap-2 rounded-md px-1 py-2 text-base font-medium text-neutral-700 hover:text-[var(--accent)] dark:text-neutral-300">
                <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                {{ 'THEME_BASTION.SEARCH.OPEN'|t }}
            </button>
            {% endif %}
            <nav aria-label="{{ 'THEME_BASTION.ARIA.MOBILE_NAV'|t|e('html_attr') }}">
                {% include 'partials/navigation.html.twig' %}
            </nav>
            <div class="mt-4 border-t border-neutral-200 pt-4 dark:border-neutral-800">
                {% include 'partials/theme-toggle.html.twig' with {labeled: true} %}
            </div>
        </div>
    </div>
    {% endblock %}

    {% include 'partials/search-overlay.html.twig' ignore missing %}

{% block bottom %}
    {{ assets.js('bottom')|raw }}
{% endblock %}
</body>
</html>
