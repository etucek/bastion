{% set body_classes = body_class(['header-fixed', 'header-animated', 'header-transparent', 'header-dark', 'header-light', 'sticky-footer']) %}
{% set theme_default = theme_var('theme-mode') ?: 'auto' %}
{% set accent_configured = theme_var('accent-color') %}
{% set accent_is_hex = accent_configured and accent_configured matches '/^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$/' %}
{% set accent = accent_is_hex ? accent_configured : '#2563eb' %}
{% set favicon = theme_var('custom_favicon') %}
{% set favicon_first = (favicon is iterable and favicon|length > 0) ? favicon|first : null %}
{% set favicon_file = favicon_first.name|default(null) %}
{% set favicon_type = favicon_first.type|default('image/png') %}
{% set show_login = theme_var('login.enabled') and config.plugins.login.enabled %}
{% set show_langswitcher = theme_var('langswitcher.enabled') and config.plugins.langswitcher.enabled and langswitcher.languages|default([])|length > 1 %}
{% use 'blocks/base.html.twig' %}
<!DOCTYPE html>
<html lang="{{ grav.language.getActive ?: grav.config.site.default_lang }}"
      data-theme-default="{{ theme_default }}">
<head>
{% block head deferred %}
    <meta charset="utf-8" />
    <title>{% if page.title %}{{ page.title|e('html') }} | {% endif %}{{ site.title|e('html') }}</title>
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light dark">

    {% include 'partials/metadata.html.twig' %}

    {% if favicon_file %}
    <link rel="icon" type="{{ favicon_type }}" href="{{ url('theme://images/favicon/' ~ favicon_file) }}" />
    {% else %}
    <link rel="icon" type="image/svg+xml" href="{{ url('theme://images/bastion-favicon.svg') }}" />
    {% endif %}
    <link rel="canonical" href="{{ page.url(true, true) }}" />

    {# Preload the critical latin subsets so headings + body text render in-font on first paint #}
    <link rel="preload" as="font" type="font/woff2" crossorigin href="{{ url('theme://fonts/cal-sans/cal-sans-latin.woff2') }}" />
    <link rel="preload" as="font" type="font/woff2" crossorigin href="{{ url('theme://fonts/inter/inter-latin.woff2') }}" />

    {# Always emitted (not just when a custom accent is configured) - this is
       the only place --accent is defined. An external-stylesheet fallback
       would load after this inline block and silently win the cascade
       (same specificity, later source position), overriding the real
       configured color on every page - which is exactly what happened
       before this was made unconditional. #}
    <style>
      :root {
        --accent: {{ accent }};
        --accent-darker: color-mix(in oklab, {{ accent }} 80%, black 20%);
        --accent-contrast: #ffffff;
        --link: {{ accent }};
        --focus-ring: color-mix(in oklab, {{ accent }} 45%, transparent);
      }
      :root[data-theme='dark'] {
        --accent: color-mix(in oklab, {{ accent }} 80%, white 20%);
        --accent-darker: color-mix(in oklab, {{ accent }} 65%, white 15%);
        --accent-contrast: #ffffff;
        --link: color-mix(in oklab, {{ accent }} 75%, white 25%);
        --focus-ring: color-mix(in oklab, {{ accent }} 45%, transparent);
      }
    </style>

    {# Pre-paint theme bootstrap — blocks FOUC by setting data-theme synchronously #}
    <script>
    (function () {
      try {
        var d = document.documentElement;
        var stored = localStorage.getItem('bastion-theme');
        var pref = stored || d.getAttribute('data-theme-default') || 'auto';
        var isDark = pref === 'dark' || (pref === 'auto' && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches);
        d.setAttribute('data-theme', isDark ? 'dark' : 'light');
        d.setAttribute('data-theme-preference', pref);
        d.classList.toggle('dark', isDark);
      } catch (e) {}
    })();
    </script>
{% endblock head %}

{% block stylesheets %}
    {% do assets.addCss('theme://css/fonts.css', 100) %}
    {% do assets.addCss('theme://build/css/site.css', 90) %}
    {% do assets.addCss('theme://css/fontawesome/css/all.min.css', 85) %}
    {% do assets.addCss('theme://css/custom.css', 1) %}
    {% do assets.addCss('theme://vendor/glightbox/glightbox.min.css', 75) %}
{% endblock %}

{% block javascripts %}
    {% do assets.addJs('theme://js/theme-toggle.js', {group:'head', priority: 100}) %}
    {% do assets.addJs('theme://vendor/glightbox/glightbox.min.js', {group: 'bottom'}) %}
    {% do assets.addJs('theme://js/site.js', {group:'bottom', priority: 100}) %}
    {% do assets.addInlineJs("document.addEventListener('DOMContentLoaded', function() { if (window.GLightbox) { GLightbox({selector: '.glightbox', touchNavigation: true, loop: false, zoomable: true, draggable: true}); } });", {group: 'bottom'}) %}
{% endblock %}

{% block assets deferred %}
    {{ assets.css()|raw }}
    {{ assets.js()|raw }}
{% endblock %}
</head>
<body id="top" class="{% block body_classes %}{{ body_classes }}{% endblock %} min-h-screen flex flex-col bg-white text-gray-900 dark:bg-gray-900 dark:text-gray-100">
    <div id="page-wrapper" class="flex flex-col flex-1">
    {% block header %}
        <header id="header" class="sticky top-0 z-50 border-b border-gray-200 bg-white/90 backdrop-blur transition-shadow dark:border-gray-800 dark:bg-gray-900/90 [.scrolled_&]:shadow-sm">
            <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
                <nav class="flex h-16 items-center justify-between gap-4" aria-label="{{ 'THEME_BASTION.ARIA.PRIMARY_NAV'|t|e('html_attr') }}">
                    <button type="button" id="toggle" data-mobile-nav-toggle="toggle" aria-expanded="false"
                            data-label-open="{{ 'THEME_BASTION.MENU.OPEN'|t|e('html_attr') }}"
                            data-label-close="{{ 'THEME_BASTION.MENU.CLOSE'|t|e('html_attr') }}"
                            class="relative -ml-2 inline-flex items-center gap-2 rounded-full border border-gray-300 py-1.5 pl-2 pr-3 hover:border-[var(--accent)] hover:text-[var(--accent)] dark:border-gray-600"
                            aria-label="{{ 'THEME_BASTION.MENU.OPEN'|t|e('html_attr') }}">
                        <span class="inline-flex h-5 w-5 items-center justify-center">
                            <span data-mobile-nav-icon="closed"><i class="fa-solid fa-bars" aria-hidden="true"></i></span>
                            <span data-mobile-nav-icon="open" class="hidden"><i class="fa-solid fa-xmark" aria-hidden="true"></i></span>
                        </span>
                        <span data-mobile-nav-label class="text-sm font-medium">{{ 'THEME_BASTION.MENU.OPEN'|t }}</span>
                    </button>
                    <div class="flex items-center gap-1">
                        {% if config.plugins.simplesearch.enabled %}
                        <button type="button" data-search-toggle="open" class="flex h-9 w-9 items-center justify-center rounded-md text-gray-600 hover:text-[var(--accent)] dark:text-gray-300" aria-label="{{ 'THEME_BASTION.SEARCH.OPEN'|t|e('html_attr') }}">
                            <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                        </button>
                        {% endif %}
                        {% if show_login %}
                            {% if grav.user.authenticated %}
                            <span class="flex items-center gap-1.5 px-2 text-sm">{% include 'partials/login-status.html.twig' %}</span>
                            {% else %}
                            <a href="{{ url(config.plugins.login.route) }}" class="flex h-9 w-9 items-center justify-center rounded-md text-gray-600 hover:text-[var(--accent)] dark:text-gray-300" aria-label="{{ 'THEME_BASTION.LOGIN.LOGIN'|t|e('html_attr') }}" title="{{ 'THEME_BASTION.LOGIN.LOGIN'|t|e('html_attr') }}">
                                <i class="fa-solid fa-user" aria-hidden="true"></i>
                            </a>
                            {% endif %}
                        {% endif %}
                        {% if show_langswitcher %}
                            {% include 'partials/langswitcher-menu.html.twig' %}
                        {% endif %}
                        {% include 'partials/theme-toggle.html.twig' %}
                    </div>
                </nav>
            </div>
        </header>
    {% endblock %}

    {% block hero %}{% endblock %}

        <main id="start" class="flex-1">
        {% block body %}
            <section id="body-wrapper" class="{{ page.header.section_classes|default('py-10') }}">
                <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
                    {% block messages %}
                        {% include 'partials/messages.html.twig' ignore missing %}
                    {% endblock %}
                    {{ block('content_surround') }}
                </div>
            </section>
        {% endblock %}
        </main>

    </div>

    {% block footer %}
        {% include 'partials/footer.html.twig' %}
    {% endblock %}

    {% block mobile %}
    <div id="overlay" class="invisible fixed inset-0 z-40 overflow-y-auto bg-black/50 opacity-0 backdrop-blur-xs transition-opacity duration-300 [&.open]:visible [&.open]:opacity-100" role="dialog" aria-label="{{ 'THEME_BASTION.ARIA.MENU'|t|e('html_attr') }}">
        <div class="mx-auto w-full max-w-xl px-4">
            <div class="h-16"></div>
            <div class="mt-2 max-h-[75vh] overflow-y-auto rounded-2xl bg-gray-800/95 p-4 shadow-2xl backdrop-blur sm:p-6">
                <nav aria-label="{{ 'THEME_BASTION.ARIA.MOBILE_NAV'|t|e('html_attr') }}">
                    {% include 'partials/navigation.html.twig' %}
                </nav>
            </div>
        </div>
    </div>
    {% endblock %}

    {% include 'partials/search-overlay.html.twig' ignore missing %}

{% block bottom %}
    {{ assets.js('bottom')|raw }}
{% endblock %}
</body>
</html>
