{% extends 'partials/langswitcher-logic.html.twig' %}

{#
  Both blocks below need the plugins.langswitcher.language_display setting
  (long/short), but language_block_start renders before langswitcher-logic's
  own {% set display_format %} line runs (it's called first, at the very
  top of that file) - so it can't be relied on there. Computing it directly
  in each block, matching the plugin's own langswitcher-short/-long
  partials, sidesteps that ordering issue entirely.
#}
{% set display_format = config.get('plugins.langswitcher.language_display', 'long') %}

{% block language_block_start %}
<div class="relative" data-dropdown>
    <button type="button" data-dropdown-toggle aria-haspopup="listbox" aria-expanded="false"
            aria-label="{{ 'THEME_BASTION.LANGUAGES'|t|e('html_attr') }}"
            class="flex h-9 items-center gap-1 rounded-md border border-gray-300 px-2 text-sm text-gray-600 hover:text-primary dark:border-gray-600 dark:text-gray-300">
        <i class="fa-solid fa-globe" aria-hidden="true"></i>
        <span class="{{ display_format == 'short' ? 'uppercase' : '' }}">
            {{ display_format == 'short' ? langswitcher.current|upper : native_name(langswitcher.current)|capitalize }}
        </span>
        <i class="fa-solid fa-chevron-down text-[0.65rem] text-gray-500 dark:text-gray-400" aria-hidden="true"></i>
    </button>
    <ul data-dropdown-panel role="listbox" aria-label="{{ 'THEME_BASTION.LANGUAGES'|t|e('html_attr') }}"
        class="invisible absolute right-0 top-full z-30 mt-1.5 min-w-32 -translate-y-1 rounded-md border border-gray-300 bg-white py-1 text-sm opacity-0 shadow-lg transition duration-200 ease-in-out [&.open]:visible [&.open]:translate-y-0 [&.open]:opacity-100 dark:border-gray-600 dark:bg-gray-800 dark:shadow-black/40">
{% endblock %}

{% block language_block_end %}
    </ul>
</div>
{% endblock %}

{% block language_item %}
    {% if show_language %}
    <li role="option" aria-selected="{{ active_class == 'active' ? 'true' : 'false' }}">
        <a href="{{ lang_url ~ uri.params ~ (uri.query|length > 1 ? '?' ~ uri.query) }}"
           class="block px-3 py-1.5 transition {{ active_class == 'active' ? 'font-medium text-primary' : 'text-gray-700 hover:bg-gray-100 dark:text-gray-200 dark:hover:bg-gray-700' }}">
            {{ display_format == 'short' ? language|upper : native_name(language)|capitalize }}
        </a>
    </li>
    {% endif %}
{% endblock %}
