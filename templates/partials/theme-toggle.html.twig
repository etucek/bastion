{% set labeled = labeled|default(false) %}
{# Mode names and the sentences built from them are passed to theme-toggle.js as
   data attributes, because the button's label changes on click and the script
   has no access to Grav's translations. A child theme overriding
   THEME_BASTION.THEME_TOGGLE.* in its own languages.yaml changes both. #}
<button type="button"
        class="theme-toggle flex h-8 w-8 items-center justify-center rounded-md text-neutral-600 hover:text-[var(--accent)] dark:text-neutral-300"
        data-theme-toggle
        data-label-auto="{{ 'THEME_BASTION.THEME_TOGGLE.AUTO'|t|e('html_attr') }}"
        data-label-light="{{ 'THEME_BASTION.THEME_TOGGLE.LIGHT'|t|e('html_attr') }}"
        data-label-dark="{{ 'THEME_BASTION.THEME_TOGGLE.DARK'|t|e('html_attr') }}"
        data-aria-template="{{ 'THEME_BASTION.THEME_TOGGLE.ARIA_LABEL'|t|e('html_attr') }}"
        data-title-template="{{ 'THEME_BASTION.THEME_TOGGLE.TITLE'|t|e('html_attr') }}"
        aria-label="{{ 'THEME_BASTION.THEME_TOGGLE.LABEL'|t|e('html_attr') }}"
        title="{{ 'THEME_BASTION.THEME_TOGGLE.LABEL'|t|e('html_attr') }}">
    {# Sun (light), Moon (dark), Adjust (auto) — Font Awesome 7 free. Visibility is
       driven by the data-mode attribute theme-toggle.js sets on this button. #}
    <i class="icon icon-sun hidden fa-solid fa-sun" aria-hidden="true"></i>
    <i class="icon icon-moon hidden fa-solid fa-moon" aria-hidden="true"></i>
    <i class="icon icon-auto hidden fa-solid fa-circle-half-stroke" aria-hidden="true"></i>
    {% if labeled %}<span class="ml-2">{{ 'THEME_BASTION.THEME_TOGGLE.LABEL'|t }}</span>{% endif %}
</button>
