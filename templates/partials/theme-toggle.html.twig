{#
  Mode names are read by theme-toggle.js via data-mode-option; the aria
  labels come from translations so a child theme overriding
  THEME_BASTION.THEME_TOGGLE.* in its own languages.yaml changes both.
#}
<div data-theme-toggle
     class="theme-toggle relative inline-flex items-center rounded-full border border-gray-300 p-0.5 dark:border-gray-600"
     role="radiogroup" aria-label="{{ 'THEME_BASTION.THEME_TOGGLE.LABEL'|t }}">
    <span data-theme-indicator class="absolute inset-y-0.5 left-0.5 w-7 rounded-full bg-gray-200 transition-transform duration-200 ease-out dark:bg-gray-700"></span>

    <button type="button" data-mode-option="light" role="radio" aria-label="{{ 'THEME_BASTION.THEME_TOGGLE.LIGHT'|t|e('html_attr') }}"
            class="relative z-10 flex h-7 w-7 items-center justify-center rounded-full hover:text-[var(--accent)]">
        <i class="fa-solid fa-sun text-sm" aria-hidden="true"></i>
    </button>
    <button type="button" data-mode-option="auto" role="radio" aria-label="{{ 'THEME_BASTION.THEME_TOGGLE.AUTO'|t|e('html_attr') }}"
            class="relative z-10 flex h-7 w-7 items-center justify-center rounded-full hover:text-[var(--accent)]">
        <i class="fa-solid fa-circle-half-stroke text-sm" aria-hidden="true"></i>
    </button>
    <button type="button" data-mode-option="dark" role="radio" aria-label="{{ 'THEME_BASTION.THEME_TOGGLE.DARK'|t|e('html_attr') }}"
            class="relative z-10 flex h-7 w-7 items-center justify-center rounded-full hover:text-[var(--accent)]">
        <i class="fa-solid fa-moon text-sm" aria-hidden="true"></i>
    </button>
</div>
